{
  "name": "dsh-relic-boot",
  "version": "0.5.2-relic.1",
  "description": "RELIC boot animation for DeepSeek Harness: a fan-made Cyberpunk 2077-inspired splash, terminal sequence and SYNC SUCCESSFUL finale.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "Pendragon233",
    "url": "https://github.com/Pendragon233"
  },
  "contributors": [
    {
      "name": "Ziyang Song",
      "url": "https://github.com/yannicksong0106",
      "comment": "Original dsh-550c-boot, MIT"
    },
    {
      "name": "Voidpocket",
      "url": "https://github.com/Voidpocket",
      "comment": "Original 550C splash animation source"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pendragon233/dsh-relic-boot.git"
  },
  "homepage": "https://github.com/Pendragon233/dsh-relic-boot#readme",
  "bugs": {
    "url": "https://github.com/Pendragon233/dsh-relic-boot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "relic",
    "boot-animation",
    "splash",
    "cyberpunk",
    "fan-made"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "suite": {
      "id": "dsh-relic",
      "role": "boot",
      "title": "RELIC",
      "recommends": [],
      "note": "RELIC boot animation, forked from dsh-550c-boot (MIT)."
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "web:index-inject",
      "dom:overlay",
      "browser:local-storage",
      "desktop:titlebar-overlay",
      "web:http-route",
      "network:npm-registry"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.0-rc.1",
        "0.2.0-rc.2"
      ]
    },
    "capability": {
      "id": "boot-splash",
      "kind": "ui",
      "invocation": "Boot the profile's Web GUI, then read the first frame from the page: document.querySelector('.dsh550c-host') and its shadowRoot's #boot stage, plus document.documentElement.classList.contains('dsh550c-first') on the way in.",
      "expected": "The host half's first frame covers the shell while the document is still parsing, so DSH's [data-dsh-boot] card is never visible; the client splash then mounts the ported #boot stage in a shadow root on the same task that retires that cover, and plays to completion."
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "dependencies": {}
}
